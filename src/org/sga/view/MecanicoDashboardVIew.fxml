<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="dashboard-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.sga.controller.MecanicoDashboardController">
    <stylesheets>
        <URL value="@/org/sga/view/style/mecanicodashboardview.css" />
    </stylesheets>
    <left>
        <VBox prefWidth="190.0" spacing="6.0" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="20.0" left="22.0" right="16.0" top="28.0" />
            </padding>
            <children>
                <Label styleClass="sidebar-brand" text="SGA" />
                <Region prefHeight="3.0" prefWidth="36.0" styleClass="sidebar-brand-line">
                    <VBox.margin>
                        <Insets bottom="20.0" top="8.0" />
                    </VBox.margin>
                </Region>
                <Label styleClass="sidebar-section" text="NAVEGACIÓN" />
                <VBox spacing="10.0">
                    <VBox.margin>
                        <Insets bottom="20.0" top="8.0" />
                    </VBox.margin>
                    <children>
                        <Label styleClass="sidebar-link-active" text="Menú principal" />
                    </children>
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
                <Region maxWidth="Infinity" prefHeight="1.0" styleClass="sidebar-divider">
                    <VBox.margin>
                        <Insets bottom="14.0" />
                    </VBox.margin>
                </Region>
                <Label fx:id="lblUsuarioSidebar" prefHeight="17.0" styleClass="sidebar-user" text="Mecánico">
                    <VBox.margin>
                        <Insets bottom="6.0" />
                    </VBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#eventoCerrarSesion" styleClass="sidebar-logout" text="Cerrar sesión" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="15.0" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="30.0" left="34.0" right="34.0" top="26.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Label styleClass="app-title" text="SISTEMA DE GESTIÓN AUTOMOTRIZ" />
                    </children>
                </HBox>
                <Label fx:id="lblBienvenida" styleClass="welcome-title" text="Bienvenido!">
                    <VBox.margin>
                        <Insets top="14.0" />
                    </VBox.margin>
                </Label>
                <Label styleClass="welcome-subtitle" text="Cola y estados del taller">
                    <VBox.margin>
                        <Insets bottom="5.0" />
                    </VBox.margin>
                </Label>

                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <children>
                        <Label styleClass="indicator-label" text="VEHÍCULOS EN COLA DE TALLER" />
                        <Label fx:id="lblConteoCola" styleClass="welcome-subtitle" text="" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#eventoMostrarCola" prefHeight="32.0" prefWidth="150.0" styleClass="dashboard-card" text="Actualizar cola" />
                    </children>
                </HBox>

                <TableView fx:id="tablaCola" prefHeight="300.0" VBox.vgrow="ALWAYS">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="columnaId" prefWidth="45.0" text="ID" />
                        <TableColumn fx:id="columnaPlaca" prefWidth="90.0" text="Placa" />
                        <TableColumn fx:id="columnaMarca" prefWidth="100.0" text="Marca" />
                        <TableColumn fx:id="columnaModelo" prefWidth="100.0" text="Modelo" />
                        <TableColumn fx:id="columnaAnio" prefWidth="55.0" text="Año" />
                        <TableColumn fx:id="columnaEstado" prefWidth="140.0" text="Estado" />
                        <TableColumn fx:id="columnaObservaciones" prefWidth="220.0" text="Observaciones" />
                        <TableColumn fx:id="columnaFechaIngreso" prefWidth="130.0" text="Fecha de ingreso" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label styleClass="indicator-label" text="Nuevo estado:" />
                        <ComboBox fx:id="comboEstado" prefWidth="220.0" promptText="Seleccionar estado" />
                        <Button mnemonicParsing="false" onAction="#eventoCambiarEstado" prefHeight="36.0" prefWidth="170.0" styleClass="dashboard-card, dashboard-card-alt" text="Cambiar estado" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#eventoProximamente" prefHeight="36.0" prefWidth="170.0" styleClass="dashboard-card" text="Liberar a Disponible" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>