<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0" styleClass="dashboard-root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.sga.controller.MecanicoDashboardController">
    <stylesheets>
        <URL value="@/org/sga/view/style/mecanicodashboardview.css" />
    </stylesheets>
    <left>
        <VBox prefWidth="190.0" spacing="6.0" styleClass="sidebar" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="20.0" left="22.0" right="16.0" top="28.0" />
            </padding>
            <children>
                <Label styleClass="sidebar-brand" text="SGA" />
                <Region prefHeight="3.0" prefWidth="36.0" styleClass="sidebar-brand-line">
                    <VBox.margin>
                        <Insets bottom="20.0" top="8.0" />
                    </VBox.margin>
                </Region>
                <Label styleClass="sidebar-section" text="NAVEGACIÓN" />
                <VBox spacing="10.0">
                    <VBox.margin>
                        <Insets bottom="20.0" top="8.0" />
                    </VBox.margin>
                    <children>
                        <Label styleClass="sidebar-link-active" text="Menú principal" />
                        <Label styleClass="sidebar-link" text="Taller" />
                        <Label styleClass="sidebar-link" text="Cola de trabajo" />
                    </children>
                </VBox>
                <Region VBox.vgrow="ALWAYS" />
                <Region maxWidth="Infinity" prefHeight="1.0" styleClass="sidebar-divider">
                    <VBox.margin>
                        <Insets bottom="14.0" />
                    </VBox.margin>
                </Region>
                <Label fx:id="lblUsuarioSidebar" prefHeight="17.0" styleClass="sidebar-user" text="Mecánico">
                    <VBox.margin>
                        <Insets bottom="6.0" />
                    </VBox.margin>
                </Label>
                <Button mnemonicParsing="false" onAction="#eventoCerrarSesion" styleClass="sidebar-logout" text="Cerrar sesión" />
            </children>
        </VBox>
    </left>
    <center>
        <VBox spacing="15.0" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets bottom="30.0" left="34.0" right="34.0" top="26.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_RIGHT">
                    <children>
                        <Label styleClass="app-title" text="SISTEMA DE GESTIÓN AUTOMOTRIZ" />
                    </children>
                </HBox>
                <Label fx:id="lblBienvenida" styleClass="welcome-title" text="Bienvenido!">
                    <VBox.margin>
                        <Insets top="14.0" />
                    </VBox.margin>
                </Label>
                <Label styleClass="welcome-subtitle" text="Cola y estados del taller">
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Label>
                <GridPane hgap="16.0" vgap="16.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="180.0" prefWidth="220.0" />
                        <ColumnConstraints minWidth="180.0" prefWidth="220.0" />
                        <ColumnConstraints minWidth="180.0" prefWidth="220.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="70.0" prefHeight="80.0" />
                    </rowConstraints>
                    <children>
                        <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eventoMostrarCola" styleClass="dashboard-card" text="Cola de vehículos" wrapText="true" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eventoCambiarEstado" styleClass="dashboard-card, dashboard-card-alt" text="Cambiar estado de trabajo" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Button maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eventoProximamente" styleClass="dashboard-card" text="Liberar a Disponible" wrapText="true" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    </children>
                </GridPane>
                <Label styleClass="indicator-label" text="VEHÍCULOS EN COLA DE TALLER" />
                <TableView fx:id="tablaCola" prefHeight="300.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="columnaId" prefWidth="55.0" text="ID" />
                        <TableColumn fx:id="columnaPlaca" prefWidth="100.0" text="Placa" />
                        <TableColumn fx:id="columnaMarca" prefWidth="120.0" text="Marca" />
                        <TableColumn fx:id="columnaModelo" prefWidth="120.0" text="Modelo" />
                        <TableColumn fx:id="columnaAnio" prefWidth="70.0" text="Año" />
                        <TableColumn fx:id="columnaEstado" prefWidth="160.0" text="Estado" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <children>
                        <Label styleClass="indicator-label" text="Nuevo estado:" />
                        <ComboBox fx:id="comboEstado" prefWidth="220.0" promptText="Seleccionar estado" />
                        <Label styleClass="welcome-subtitle" text="Selecciona un vehículo y cambia su estado." />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>