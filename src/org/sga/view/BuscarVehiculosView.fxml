<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="540.0" prefWidth="780.0" styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.sga.controller.BuscarVehiculosController">
    <stylesheets>
        <URL value="@/org/sga/view/style/ventasview.css" />
    </stylesheets>
    <children>

        <Button layoutX="14.0" layoutY="19.0" mnemonicParsing="false" onAction="#eventoVolver" prefHeight="25.0" prefWidth="89.0" text="Regresar" />

        <Label layoutX="215.0" layoutY="15.0" styleClass="page-title" text="Buscar Vehículos Disponibles">
            <font>
                <Font size="22.0" />
            </font>s
        </Label>

        <Label layoutX="30.0" layoutY="72.0" styleClass="field-label" text="Marca, modelo o placa" />
        <TextField fx:id="txtCriterio" layoutX="30.0" layoutY="92.0" onAction="#eventoBuscar" prefHeight="30.0" prefWidth="280.0" promptText="Ej: Toyota, Corolla o P001ABC" styleClass="text-input" />

        <Label layoutX="330.0" layoutY="72.0" styleClass="field-label" text="Operación" />
        <ComboBox fx:id="cmbOperacion" layoutX="330.0" layoutY="92.0" prefHeight="30.0" prefWidth="150.0" styleClass="text-input" />

        <Button layoutX="500.0" layoutY="92.0" mnemonicParsing="false" onAction="#eventoBuscar" prefHeight="30.0" prefWidth="110.0" styleClass="primary-button" text="BUSCAR" />
        <Button layoutX="625.0" layoutY="92.0" mnemonicParsing="false" onAction="#eventoLimpiar" prefHeight="30.0" prefWidth="110.0" styleClass="secondary-button" text="LIMPIAR" />

        <TableView fx:id="tblVehiculos" layoutX="30.0" layoutY="140.0" prefHeight="340.0" prefWidth="720.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colPlaca" prefWidth="80.0" text="Placa" />
                <TableColumn fx:id="colMarca" prefWidth="90.0" text="Marca" />
                <TableColumn fx:id="colModelo" prefWidth="90.0" text="Modelo" />
                <TableColumn fx:id="colTipo" prefWidth="75.0" text="Tipo" />
                <TableColumn fx:id="colAnio" prefWidth="50.0" text="Año" />
                <TableColumn fx:id="colColor" prefWidth="70.0" text="Color" />
                <TableColumn fx:id="colCondicion" prefWidth="75.0" text="Condición" />
                <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                <TableColumn fx:id="colOperacion" prefWidth="80.0" text="Operación" />
            </columns>
        </TableView>

        <Label fx:id="lblConteo" layoutX="30.0" layoutY="495.0" styleClass="field-label" text="" />

    </children>
</AnchorPane>