<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="480.0" prefWidth="760.0" styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/21.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.sga.controller.HistorialVentasController">
    <stylesheets>
        <URL value="@style/buscarvehiculosview.css" />
    </stylesheets>
    <children>

        <Button layoutX="14.0" layoutY="19.0" mnemonicParsing="false" onAction="#eventoVolver" prefHeight="25.0" prefWidth="89.0" text="Regresar" />

        <Label layoutX="245.0" layoutY="15.0" styleClass="page-title" text="Mi Historial de Ventas">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <TableView fx:id="tblVentas" layoutX="30.0" layoutY="70.0" prefHeight="330.0" prefWidth="700.0" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colNumero" prefWidth="70.0" text="No. venta" />
                <TableColumn fx:id="colPlaca" prefWidth="80.0" text="Placa" />
                <TableColumn fx:id="colVehiculo" prefWidth="170.0" text="Vehículo" />
                <TableColumn fx:id="colCliente" prefWidth="150.0" text="Cliente" />
                <TableColumn fx:id="colPrecio" prefWidth="100.0" text="Precio" />
                <TableColumn fx:id="colFecha" prefWidth="120.0" text="Fecha" />
            </columns>
        </TableView>

        <Label fx:id="lblResumen" layoutX="30.0" layoutY="420.0" styleClass="field-label" text="" />
        <Button layoutX="590.0" layoutY="415.0" mnemonicParsing="false" onAction="#eventoActualizar" prefHeight="30.0" prefWidth="140.0" styleClass="secondary-button" text="ACTUALIZAR" />

    </children>
</AnchorPane>